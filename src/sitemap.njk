---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Sitemap automático: todas las páginas publicadas e indexables, con la fecha de su último cambio. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all | paraSitemap %}
  <url>
    <loc>{{ site.url }}{{ p.data.canonical or p.url }}</loc>
    <lastmod>{{ p.date.toISOString().slice(0, 10) }}</lastmod>
  </url>
{%- endfor %}
</urlset>
