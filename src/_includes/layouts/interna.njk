{#- Plantilla de las páginas internas (programas, sede y páginas de la raíz como donar.html).
    Encabezado ---: title, description, canonical (ruta), nombre (nombre corto para las migas),
    migas (opcional: [{ nombre, url }] desde la raíz, sin Inicio ni la página actual), bodyClass (opcional),
    ogImagen (opcional), jsonLd (opcional, objeto), lugar (opcional: ciudad de una sede → JSON-LD Place)
    e indexar: false (opcional). -#}
{%- set raiz = raizFija or (page.url | raiz) -%}
<!DOCTYPE html>
<html lang="es-CO">
<head>
{%- include "partials/head.njk" %}
  {#- Migas de pan para buscadores (las mismas que se ven en la página) #}
  <script type="application/ld+json">{{ migas | migasLd(nombre, canonical) | json | safe }}</script>
  {%- if programa %}
  <script type="application/ld+json">{{ site | programaLd(programa, description) | json | safe }}</script>
  {%- endif %}
  {%- if lugar %}
  <script type="application/ld+json">{{ site | lugarLd(lugar) | json | safe }}</script>
  {%- endif %}
  {%- if jsonLd %}
  <script type="application/ld+json">{{ jsonLd | json | safe }}</script>
  {%- endif %}
</head>
<body class="program-page{% if bodyClass %} {{ bodyClass }}{% endif %}">
  <a class="skip-link" href="#main">Saltar al contenido principal</a>
{%- set portada = false %}
{%- include "partials/nav.njk" %}

  <nav class="migas" aria-label="Migas de pan">
    <ol>
      <li><a href="{{ raiz or './' }}">Inicio</a></li>
      {%- for miga in migas %}
      <li><a href="{{ raiz }}{{ miga.url }}">{{ miga.nombre }}</a></li>
      {%- endfor %}
      <li><span aria-current="page">{{ nombre }}</span></li>
    </ol>
  </nav>

  <main id="main">
{{ content | safe }}
{%- if programa %}
{%- include "partials/convocatorias.njk" %}
{%- include "partials/faq.njk" %}
{%- include "partials/otros-programas.njk" %}
{%- endif %}
  </main>
{%- include "partials/pie.njk" %}

  <script type="application/json" id="site-data">{{ { whatsapp: site.whatsapp, whatsappLabel: site.whatsappLabel, analytics: site.analytics } | json | safe }}</script>
  <script type="module" src="{{ raiz }}assets/js/interna.js?v={{ 'js' | huella }}"></script>
</body>
</html>
